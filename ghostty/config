font-family = "Liga SFMono Nerd Font"
font-size = 20
font-thicken = true

# window
macos-titlebar-style = hidden
window-padding-x = 36
window-padding-y = 36
window-padding-balance = true
scrollbar = never

background = 000000
background-opacity = 0.8
background-blur-radius = 32

# ssh: copy Ghostty's terminfo to new hosts, fall back to xterm-256color if that fails
shell-integration-features = ssh-terminfo,ssh-env

cursor-style = bar
cursor-style-blink = false

# colors (from iTerm2 Default profile)
foreground = bbbbbb
cursor-color = ffa560
selection-background = 363983
selection-foreground = f2f2f2
palette = 0=#4f4f4f
palette = 1=#ff6c60
palette = 2=#a8ff60
palette = 3=#ffffb6
palette = 4=#96cbfe
palette = 5=#ff73fd
palette = 6=#c6c5fe
palette = 7=#eeeeee
palette = 8=#7c7c7c
palette = 9=#ffb6b0
palette = 10=#ceffac
palette = 11=#ffffcc
palette = 12=#b5dcff
palette = 13=#ff9cfe
palette = 14=#dfdffe
palette = 15=#ffffff
